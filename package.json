{
  "name": "ux-mind-helpers",
  "version": "1.6.0",
  "description": "Reusable scripts for UX Mind projects. Zero dependencies.",
  "type": "module",
  "bin": {
    "ux-mind-helpers": "scripts/cli.mjs"
  },
  "scripts": {
    "codemod:fix-relative-imports": "node scripts/fix-relative-imports.mjs",
    "codemod:migrate-tailwind-arbitraries": "node scripts/migrate-tailwind-arbitraries.mjs",
    "codemod:react-namespace-imports": "node scripts/react-namespace-imports.mjs",
    "codemod:lucide-icon-suffix": "node scripts/lucide-icon-suffix.mjs",
    "codemod:check-no-memo-carveout": "node scripts/check-no-memo-carveout.mjs",
    "codemod:check-icon-button-label": "node scripts/check-icon-button-label.mjs",
    "codemod:collapse-comments": "node scripts/collapse-comments.mjs",
    "test": "node tests/test.mjs && node tests/check-no-memo-carveout.test.mjs && node tests/check-icon-button-label.test.mjs && node tests/collapse-comments.test.mjs",
    "prepublishOnly": "npm test"
  },
  "files": ["scripts/", "README.md"],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antonchuvirau/ux-mind-helpers.git"
  },
  "homepage": "https://github.com/antonchuvirau/ux-mind-helpers#readme",
  "bugs": {
    "url": "https://github.com/antonchuvirau/ux-mind-helpers/issues"
  },
  "keywords": [
    "typescript",
    "tailwind",
    "react",
    "react-compiler",
    "lucide",
    "codemod",
    "migration",
    "imports"
  ],
  "license": "MIT"
}
